{"underlines":[{"sentence":1889,"decidedBy":"model","reference":{"range":[29,13],"text":"said Marilla.","paragraph":561,"sentence":1884},"range":[39,7],"kind":"person","id":"1889:39","text":"Marilla","paragraph":565},{"sentence":1902,"decidedBy":"model","reference":{"range":[0,35],"text":"Anne’s Impressions of Sunday-school","paragraph":560,"sentence":1882},"range":[396,31],"kind":"place","id":"1902:396","text":"is for church and Sunday-school","paragraph":569},{"sentence":1910,"decidedBy":"model","reference":{"range":[37,91],"text":"“But I’d be ever so much gratefuller if—if you’d made just one of them with puffed sleeves.","paragraph":570,"sentence":1906},"range":[48,46],"kind":"thing","id":"1910:48","text":"hadn’t any material to waste on puffed sleeves","paragraph":571},{"sentence":1915,"decidedBy":"model","reference":{"range":[0,35],"text":"Anne’s Impressions of Sunday-school","paragraph":560,"sentence":1882},"range":[97,30],"kind":"action","id":"1915:97","text":"learn the Sunday-school lesson","paragraph":573},{"sentence":1917,"decidedBy":"model","reference":{"range":[0,97],"text":"Anne was standing in the gable room, looking solemnly at three new dresses spread out on the bed.","paragraph":562,"sentence":1885},"range":[27,21],"kind":"action","id":"1917:27","text":"looked at the dresses","paragraph":574},{"sentence":1918,"decidedBy":"model","reference":{"range":[37,91],"text":"“But I’d be ever so much gratefuller if—if you’d made just one of them with puffed sleeves.","paragraph":570,"sentence":1906},"range":[3,55],"kind":"place","id":"1918:3","text":"did hope there would be a white one with puffed sleeves","paragraph":575},{"sentence":1940,"decidedBy":"model","reference":{"range":[0,49],"text":"Anne clasped her hands and looked at the dresses.","paragraph":574,"sentence":1917},"range":[584,13],"kind":"action","id":"1940:584","text":"looked at her","paragraph":579},{"sentence":1942,"decidedBy":"model","reference":{"range":[652,137],"text":"Nobody made any friendly advances, then or later on when the opening exercises were over and Anne found herself in Miss Rogerson’s class.","paragraph":579,"sentence":1941},"range":[0,13],"kind":"person","id":"1942:0","text":"Miss Rogerson","paragraph":580},{"sentence":1947,"decidedBy":"model","reference":{"range":[0,35],"text":"Anne’s Impressions of Sunday-school","paragraph":560,"sentence":1882},"range":[11,26],"kind":"action","id":"1947:11","text":"did you like Sunday-school","paragraph":582},{"sentence":1955,"decidedBy":"model","reference":{"range":[0,45],"text":"“Well, you’ll have to do without your thrill.","paragraph":571,"sentence":1909},"range":[6,41],"kind":"place","id":"1955:6","text":"might have been lonesome while I was away","paragraph":586},{"sentence":1964,"decidedBy":"model","reference":{"range":[327,37],"text":"Mr. Bell made an awfully long prayer.","paragraph":586,"sentence":1960},"range":[51,32],"kind":"action","id":"1964:51","text":"should have listened to Mr. Bell","paragraph":587},{"sentence":1970,"decidedBy":"model","reference":{"range":[168,83],"text":"It would give me such a thrill, Marilla, just to wear a dress with puffed sleeves.”","paragraph":570,"sentence":1908},"range":[364,16],"kind":"action","id":"1970:364","text":"gave me a thrill","paragraph":588},{"sentence":1975,"decidedBy":"model","reference":{"range":[46,49],"text":"I hadn’t any material to waste on puffed sleeves.","paragraph":571,"sentence":1910},"range":[184,18],"kind":"action","id":"1975:184","text":"had puffed sleeves","paragraph":590},{"sentence":1981,"decidedBy":"model","reference":{"range":[0,47],"text":"“Not out loud, I hope,” said Marilla anxiously.","paragraph":589,"sentence":1971},"range":[119,16],"kind":"action","id":"1981:119","text":"hope you knew it","paragraph":591},{"sentence":1982,"decidedBy":"model","reference":{"range":[270,175],"text":"She looked very often at Anne, and Anne, thanks to Marilla’s drilling, answered promptly; but it may be questioned if she understood very much about either question or answer.","paragraph":580,"sentence":1944},"range":[16,27],"kind":"reaction","id":"1982:16","text":"answered a lot of questions","paragraph":592},{"sentence":1999,"decidedBy":"model","reference":{"range":[153,68],"text":"Stay to preaching afterwards and ask Mrs. Lynde to show you our pew.","paragraph":577,"sentence":1927},"range":[248,16],"kind":"action","id":"1999:248","text":"show me your pew","paragraph":595}],"engineVersion":4,"parserVersion":1}