ference":{"range":[0,20],"sentence":9246,"text":"“Faith, sir, I’ve——”","paragraph":2570},"sentence":9249,"range":[55,15],"id":"9249:55","paragraph":2572,"text":"that’s all, sir"},{"kind":"action","decidedBy":"model","reference":{"range":[40,14],"sentence":9216,"text":"Oh, look, sir!","paragraph":2558},"sentence":9254,"range":[69,17],"id":"9254:69","paragraph":2575,"text":"Look at thy bosom"},{"kind":"person","decidedBy":"model","reference":{"range":[139,74],"sentence":9244,"text":"And yet, a coffin with a body in it rings pretty much the same, Carpenter.","paragraph":2569},"sentence":9285,"range":[802,9],"id":"9285:802","paragraph":2578,"text":"Carpenter"}],"engineVersion":4}