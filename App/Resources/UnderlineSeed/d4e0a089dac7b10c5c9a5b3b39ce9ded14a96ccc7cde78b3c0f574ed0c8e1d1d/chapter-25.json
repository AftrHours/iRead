{"underlines":[{"id":"2140:1","text":"Ain’t going aboard, then","reference":{"sentence":2137,"range":[0,15],"paragraph":697,"text":"“Going aboard?”"},"decidedBy":"model","sentence":2140,"range":[1,24],"paragraph":700,"kind":"reaction"},{"id":"2142:60","text":"Do you know, Mr. Elijah","reference":{"sentence":2136,"range":[254,14],"paragraph":696,"text":"It was Elijah."},"decidedBy":"model","sentence":2142,"range":[60,23],"paragraph":701,"kind":"action"},{"id":"2144:23","text":"will oblige my friend","reference":{"sentence":2138,"range":[0,30],"paragraph":698,"text":"“Hands off, will you,” said I."},"decidedBy":"model","sentence":2144,"range":[23,21],"paragraph":703,"kind":"action"},{"id":"2150:10","text":"cried stationary Elijah","reference":{"sentence":2136,"range":[254,14],"paragraph":696,"text":"It was Elijah."},"decidedBy":"model","sentence":2150,"range":[10,23],"paragraph":706,"kind":"feeling"},{"id":"2156:69","text":"touching my shoulder again","reference":{"sentence":2152,"range":[0,156],"paragraph":708,"text":"But he stole up to us again, and suddenly clapping his hand on my shoulder, said—“Did ye see anything looking like men going towards that ship a while ago?”"},"decidedBy":"model","sentence":2156,"range":[69,26],"paragraph":711,"kind":"action"},{"id":"2165:306","text":"cracked words he finally departed","reference":{"sentence":2148,"range":[0,44],"paragraph":705,"text":"“He’s cracked, Queequeg,” said I, “come on.”"},"decidedBy":"model","sentence":2165,"range":[306,33],"paragraph":713,"kind":"reaction"},{"id":"2190:286","text":"owing to the absence of settees and sofas of all sorts, the king, chiefs, and great people generally","reference":{"sentence":2166,"range":[0,96],"paragraph":714,"text":"At last, stepping on board the Pequod, we found everything in profound quiet, not a soul moving."},"decidedBy":"model","sentence":2190,"range":[286,100],"paragraph":719,"kind":"action"},{"id":"2200:32","text":"who be ye smokers","reference":{"sentence":2146,"range":[0,14],"paragraph":704,"text":"“Ye be, be ye?"},"decidedBy":"model","sentence":2200,"range":[32,17],"paragraph":724,"kind":"thing"},{"id":"2212:3","text":"was now clear sunrise","reference":{"sentence":2133,"range":[0,144],"paragraph":695,"text":"“There are some sailors running ahead there, if I see right,” said I to Queequeg, “it can’t be shadows; she’s off by sunrise, I guess; come on!”"},"decidedBy":"model","sentence":2212,"range":[3,21],"paragraph":731,"kind":"thing"}],"engineVersion":4,"parserVersion":1}