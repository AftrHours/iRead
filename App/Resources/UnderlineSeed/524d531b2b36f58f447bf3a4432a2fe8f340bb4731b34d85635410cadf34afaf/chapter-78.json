{"parserVersion":1,"engineVersion":4,"underlines":[{"kind":"action","text":"write rather slowly","reference":{"range":[0,28],"paragraph":564,"text":"“You write uncommonly fast.”","sentence":1095},"id":"1097:21","sentence":1097,"decidedBy":"rules","range":[21,19],"paragraph":565},{"kind":"thing","text":"are generally long; but whether always charming","reference":{"range":[58,70],"paragraph":576,"text":"But do you always write such charming long letters to her, Mr. Darcy?”","sentence":1115},"id":"1116:6","sentence":1116,"decidedBy":"rules","range":[6,47],"paragraph":577},{"kind":"action","text":"does not write with ease","reference":{"range":[0,93],"paragraph":578,"text":"“It is a rule with me, that a person who can write a long letter with ease cannot write ill.”","sentence":1117},"id":"1118:87","sentence":1118,"decidedBy":"rules","range":[87,24],"paragraph":579}]}