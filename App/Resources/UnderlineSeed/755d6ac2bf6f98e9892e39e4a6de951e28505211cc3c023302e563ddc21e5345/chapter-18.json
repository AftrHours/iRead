","paragraph":1660,"sentence":3768,"range":[0,22]},"paragraph":1680},{"text":"Mr. Laurence","id":"3813:188","kind":"person","range":[188,12],"sentence":3813,"decidedBy":"model","reference":{"text":"“Children, I leave you to Hannah’s care and Mr. Laurence’s protection.","paragraph":1654,"sentence":3751,"range":[0,70]},"paragraph":1682},{"text":"is so desperately good","id":"3837:403","kind":"thing","range":[403,22],"sentence":3837,"decidedBy":"model","reference":{"text":"The girls are all as good as gold.","paragraph":1682,"sentence":3814,"range":[283,34]},"paragraph":1686},{"text":"likes my silly little things","id":"3853:73","kind":"action","range":[73,28],"sentence":3853,"decidedBy":"model","reference":{"text":"I freed my mind about a silly little thing, and he was offended.","paragraph":1686,"sentence":3842,"range":[756,64]},"paragraph":1687},{"text":"Amy","id":"3886:353","kind":"person","range":[353,3],"sentence":3886,"decidedBy":"model","reference":{"text":"Amy minds me nicely, and I take great care of her.","paragraph":1682,"sentence":3819,"range":[648,50]},"paragraph":1715},{"text":"do come soon to your loving","id":"3889:49","kind":"action","range":[49,27],"sentence":3889,"decidedBy":"model","reference":{"text":"She tries very hard, and I know you will be pleased with her improvement when you come.","paragraph":1682,"sentence":3821,"range":[788,87]},"paragraph":1716},{"text":"BETH","id":"3890:7","kind":"person","range":[7,4],"sentence":3890,"decidedBy":"model","reference":{"text":"“That’s so like my Beth!”","paragraph":1677,"sentence":3799,"range":[0,25]},"paragraph":1717},{"text":"Jo","id":"3893:243","kind":"person","range":[243,2],"sentence":3893,"decidedBy":"model","reference":{"text":"TOPSY-TURVY JO","paragraph":1688,"sentence":3855,"range":[0,14]},"paragraph":1719},{"text":"Beth","id":"3910:498","kind":"person","range":[498,4],"sentence":3910,"decidedBy":"model","reference":{"text":"LITTLE BETH","paragraph":1717,"sentence":3890,"range":[0,11]},"paragraph":1722},{"text":"sends best wishes","id":"3925:436","kind":"action","range":[436,17],"sentence":3925,"decidedBy":"model","reference":{"text":"I wish we could wash from our hearts and souls","paragraph":1696,"sentence":3863,"range":[0,46]},"paragraph":1726},{"text":"TEDDY","id":"3926:8","kind":"person","range":[8,5],"sentence":3926,"decidedBy":"model","reference":{"text":"All serene on the Rappahannock, troops in fine condition, commisary department well conducted, the Home Guard under Colonel Teddy always on duty, Commander in Chief General Laurence reviews the army daily, Quartermaster Mullet keeps order in camp, and Major Lion does picket duty at night.","paragraph":1726,"sentence":3923,"range":[0,289]},"paragraph":1727},{"text":"Hannah","id":"3930:61","kind":"person","range":[61,6],"sentence":3930,"decidedBy":"model","reference":{"text":"Hannah Mullet","paragraph":1724,"sentence":3920,"range":[0,13]},"paragraph":1729}],"engineVersion":4,"parserVersion":1}